DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pc_store"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# VNPAY Gateway (Sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:4000/api/payments/vnpay/ipn

# MoMo Gateway (Sandbox / Production)
# MOMO_ENV: "sandbox" (mặc định) cho môi trường thử nghiệm hoặc "production" khi triển khai thật
MOMO_ENV=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/orders/payment/momo-return
MOMO_IPN_URL=http://localhost:4000/api/payments/momo/ipn

# Google Places API (New) - Autocomplete địa chỉ giao hàng chỉ trong Việt Nam
# Cần bật Places API (New) trong Google Cloud Console. Để trống nếu nhập tay.
GOOGLE_PLACES_API_KEY=

# Bank Transfer QR (VietQR) Configuration
# Mã định danh ngân hàng theo chuẩn VietQR (ví dụ: MB, VCB, TCB, ACB, TPB,...)
BANK_ID=
# Số tài khoản ngân hàng nhận tiền
BANK_ACCOUNT_NUMBER=
# Tên chủ tài khoản ngân hàng (viết hoa không dấu)
BANK_ACCOUNT_NAME=
# Tên hiển thị ngân hàng (tùy chọn)
BANK_NAME=
# Mẫu hiển thị VietQR (compact, compact2, qr_only - mặc định: compact2)
VIETQR_TEMPLATE=compact2
