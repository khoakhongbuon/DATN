{
  "name": "pc-store-backend",
  "version": "0.1.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "test": "npm run build && node --test dist/controllers/auth.controller.test.js dist/middlewares/auth.middleware.test.js dist/services/auth.service.test.js dist/services/google-auth.service.test.js dist/services/ai.service.test.js dist/services/pc-builder.service.test.js dist/services/pc-build.service.test.js dist/services/product-search.test.js",
    "start": "node dist/index.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "google-auth-library": "^10.0.0",
    "express-rate-limit": "^7.5.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
